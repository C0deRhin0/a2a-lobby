{
  "openapi": "3.1.0",
  "info": { "title": "Agent Lobby Server API", "version": "0.1.0" },
  "paths": {
    "/a2a": { "post": { "summary": "A2A v1.0.1 JSON-RPC endpoint" } },
    "/mcp": { "post": { "summary": "MCP 2025-11-25 Streamable HTTP endpoint" } },
    "/v1/lobbies": { "get": { "summary": "List authorized lobbies" }, "post": { "summary": "Create lobby", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateLobbyRequest" }, "examples": { "example": { "value": { "purpose": "Coordinate an approved bounded task", "limits": { "maxMessages": 10 }, "retentionPolicy": { "plaintextMessageStorage": false }, "approvalPolicy": { "blockingByDefault": true }, "expiresAt": "2030-01-01T00:00:00.000Z" } } } } } }, "responses": { "201": { "description": "Lobby created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lobby" }, "examples": { "example": { "value": { "id": "00000000-0000-0000-0000-000000000001", "status": "pending", "purpose": "Coordinate an approved bounded task", "expiresAt": "2030-01-01T00:00:00.000Z" } } } } } } } } },
    "/v1/lobbies/{lobbyId}/invitations": { "post": { "summary": "Create a short-lived, human-readable pairing code", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateInvitationRequest" }, "examples": { "example": { "value": { "role": "counterparty", "expiresAt": "2030-01-01T00:10:00.000Z" } } } } } }, "responses": { "201": { "description": "One-time pairing code created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invitation" }, "examples": { "example": { "value": { "id": "00000000-0000-0000-0000-000000000003", "pairingCode": "ABCD-EFGH-JKLM", "expiresAt": "2030-01-01T00:10:00.000Z" } } } } } } } } },
    "/v1/lobbies/{lobbyId}/join": { "post": { "summary": "Redeem a one-time pairing code", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JoinLobbyRequest" }, "examples": { "example": { "value": { "pairingCode": "ABCD-EFGH-JKLM" } } } } } }, "responses": { "200": { "description": "Lobby joined", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lobby" } } } } } } },
    "/v1/lobbies/{lobbyId}/events": { "get": { "summary": "Catch up authorized audit/events with reconnect cursor" } },
    "/v1/lobbies/{lobbyId}/approval-proposals": { "post": { "summary": "Create a canonical SHA-256 all-required two-owner proposal" } },
    "/v1/lobbies/{lobbyId}/approval-proposals/{proposalId}/revisions": { "post": { "summary": "Supersede an approval proposal and revoke old activations" } },
    "/v1/lobbies/{lobbyId}/approval-proposals/{proposalId}/activation": { "post": { "summary": "Authenticated adapter-only one-time device-code issuance" } },
    "/v1/lobbies/{lobbyId}/approval-proposals/{proposalId}/recover": { "post": { "summary": "Authorized durable approval checkpoint recovery" } },
    "/activate": { "get": { "summary": "Public activation page without code URL parameters" }, "post": { "summary": "Redeem device code into scoped HttpOnly session" } },
    "/activate/approval/decision": { "post": { "summary": "CSRF-protected approval decision from scoped activation session" } },
    "/control-plane": { "get": { "summary": "Explicit bearer recovery/admin control plane" } }
  },
  "components": { "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } }, "schemas": { "CreateLobbyRequest": { "type": "object", "additionalProperties": false, "required": ["purpose", "limits", "retentionPolicy", "approvalPolicy", "expiresAt"], "properties": { "purpose": { "type": "string", "minLength": 8 }, "limits": { "type": "object" }, "retentionPolicy": { "type": "object", "properties": { "plaintextMessageStorage": { "const": false } }, "required": ["plaintextMessageStorage"] }, "approvalPolicy": { "type": "object", "properties": { "blockingByDefault": { "const": true } }, "required": ["blockingByDefault"] }, "expiresAt": { "type": "string", "format": "date-time" } } }, "CreateInvitationRequest": { "type": "object", "additionalProperties": false, "required": ["role", "expiresAt"], "properties": { "role": { "type": "string", "enum": ["counterparty"], "description": "Only accepted role." }, "expiresAt": { "type": "string", "format": "date-time", "description": "Required; no default expiry is applied." } } }, "JoinLobbyRequest": { "type": "object", "additionalProperties": false, "required": ["pairingCode"], "properties": { "pairingCode": { "type": "string", "pattern": "^[A-Z2-9]{4}(?:-[A-Z2-9]{4}){2}$" } } }, "Invitation": { "type": "object", "required": ["id", "pairingCode", "expiresAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "pairingCode": { "type": "string" }, "expiresAt": { "type": "string", "format": "date-time" } } }, "Lobby": { "type": "object", "required": ["id", "purpose", "status", "expiresAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "purpose": { "type": "string" }, "status": { "type": "string" }, "expiresAt": { "type": "string", "format": "date-time" } } } } }
}
